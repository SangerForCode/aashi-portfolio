# Supabase project URL (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin for metadata and sitemap (Vercel sets VERCEL_URL automatically)
NEXT_PUBLIC_SITE_URL=

# Supabase service-role key (SERVER ONLY — never exposed to the browser)
# Used exclusively for privileged bootstrap/maintenance operations.
SUPABASE_SERVICE_ROLE_KEY=
